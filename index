<!DOCTYPE html>
<html lang="pt" data-theme="light">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Informação Clínica</title>
  
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;500;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0" />

  <style>
    /* Variáveis de Tema (Cores Aliva Saúde) */
    :root {
      --primary: #c0392b;
      --primary-hover: #a93226;
      --bg-color: #f5f7f9;
      --surface: #ffffff;
      --text-main: #202124;
      --text-sec: #5f6368;
      --border: #dadce0;
      --shadow: 0 2px 6px rgba(0,0,0,0.08);
      --radius: 12px;
    }

    /* Modo Noturno */
    [data-theme="dark"] {
      --primary: #e74c3c;
      --primary-hover: #c0392b;
      --bg-color: #121212;
      --surface: #1e1e1e;
      --text-main: #e8eaed;
      --text-sec: #9aa0a6;
      --border: #3c4043;
      --shadow: 0 2px 6px rgba(0,0,0,0.4);
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }
    
    body {
      font-family: 'Roboto', sans-serif;
      background-color: var(--bg-color);
      color: var(--text-main);
      transition: background-color 0.3s, color 0.3s;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
    }

    /* Barra de Navegação Superior */
    .top-app-bar {
      background-color: var(--surface);
      border-bottom: 1px solid var(--border);
      padding: 12px 24px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      position: sticky;
      top: 0;
      z-index: 100;
      box-shadow: var(--shadow);
    }

    .brand {
      display: flex;
      align-items: center;
      gap: 12px;
      font-weight: 700;
      font-size: 1.2rem;
      color: var(--text-main);
    }

    .brand .material-symbols-outlined { color: var(--primary); font-size: 28px; }

    .nav-actions { display: flex; align-items: center; gap: 16px; }

    /* Botões Material Design */
    .btn-icon {
      background: none;
      border: none;
      color: var(--text-sec);
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      border-radius: 50%;
      width: 40px; height: 40px;
      transition: background 0.2s, color 0.2s;
    }
    .btn-icon:hover { background-color: rgba(192, 57, 43, 0.1); color: var(--primary); }

    .btn-primary {
      background-color: var(--primary);
      color: white;
      border: none;
      padding: 10px 20px;
      border-radius: 20px;
      font-size: 0.95rem;
      font-weight: 500;
      cursor: pointer;
      display: flex;
      align-items: center;
      gap: 8px;
      transition: background 0.2s, transform 0.1s;
      box-shadow: var(--shadow);
    }
    .btn-primary:hover { background-color: var(--primary-hover); }
    .btn-primary:active { transform: scale(0.97); }

    /* Layout Principal */
    main {
      flex: 1;
      width: 100%;
      max-width: 800px;
      margin: 0 auto;
      padding: 32px 20px;
    }

    /* Cartões */
    .card {
      background-color: var(--surface);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      padding: 32px;
      box-shadow: var(--shadow);
      text-align: center;
    }

    .card h2 { margin-bottom: 12px; font-weight: 500; }
    .card p { color: var(--text-sec); margin-bottom: 24px; line-height: 1.5; }

    /* Ocultar elementos via JS */
    .hidden { display: none !important; }
    
    /* Etiqueta de Utilizador */
    #user-badge {
      font-size: 0.85rem;
      color: var(--text-sec);
      font-weight: 500;
    }
  </style>
</head>
<body>

  <header class="top-app-bar">
    <div class="brand">
      <span class="material-symbols-outlined">medical_information</span>
      Informação Clínica
    </div>
    <div class="nav-actions">
      <span id="user-badge" class="hidden"></span>
      <button class="btn-icon" id="btn-theme" title="Alternar Tema">
        <span class="material-symbols-outlined" id="theme-icon">dark_mode</span>
      </button>
      <button class="btn-icon hidden" id="btn-logout" title="Sair">
        <span class="material-symbols-outlined">logout</span>
      </button>
    </div>
  </header>

  <main>
    
    <div id="login-view" class="card">
      <span class="material-symbols-outlined" style="font-size: 48px; color: var(--primary); margin-bottom: 16px;">admin_panel_settings</span>
      <h2>Acesso Restrito</h2>
      <p>Plataforma de gestão e encaminhamento de Guias de TC.<br>Faça login com o seu email institucional da Aliva Saúde para continuar.</p>
      <button class="btn-primary" id="btn-login" style="margin: 0 auto;">
        <span class="material-symbols-outlined">login</span>
        Entrar com Google
      </button>
    </div>

    <div id="app-view" class="hidden">
      <div class="card">
        <span class="material-symbols-outlined" style="font-size: 48px; color: #34a853; margin-bottom: 16px;">check_circle</span>
        <h2>Autenticado com Sucesso</h2>
        <p>A interface de Gestão de Pedidos será carregada aqui.</p>
      </div>
    </div>

  </main>

  <script type="module">
    import { auth, provider } from './firebase.js';
    import { signInWithPopup, signOut, onAuthStateChanged } from "https://www.gstatic.com/firebasejs/10.11.1/firebase-auth.js";

    // --- DOM Elements ---
    const btnLogin = document.getElementById('btn-login');
    const btnLogout = document.getElementById('btn-logout');
    const btnTheme = document.getElementById('btn-theme');
    const themeIcon = document.getElementById('theme-icon');
    const loginView = document.getElementById('login-view');
    const appView = document.getElementById('app-view');
    const userBadge = document.getElementById('user-badge');

    // --- Domínio Restrito ---
    const DOMINIO_PERMITIDO = "@alivasaude.com";

    // --- Lógica de Tema (Dark/Light) ---
    function toggleTheme() {
      const currentTheme = document.documentElement.getAttribute('data-theme');
      const newTheme = currentTheme === 'light' ? 'dark' : 'light';
      document.documentElement.setAttribute('data-theme', newTheme);
      themeIcon.textContent = newTheme === 'light' ? 'dark_mode' : 'light_mode';
      localStorage.setItem('temaInfoClinica', newTheme);
    }

    // Carregar tema guardado
    const savedTheme = localStorage.getItem('temaInfoClinica') || 'light';
    document.documentElement.setAttribute('data-theme', savedTheme);
    themeIcon.textContent = savedTheme === 'light' ? 'dark_mode' : 'light_mode';
    btnTheme.addEventListener('click', toggleTheme);

    // --- Lógica de Autenticação ---
    btnLogin.addEventListener('click', async () => {
      try {
        const result = await signInWithPopup(auth, provider);
        const email = result.user.email;
        
        // Bloqueia utilizadores de fora da clínica
        if (!email.endsWith(DOMINIO_PERMITIDO)) {
          await signOut(auth);
          alert(`Acesso negado! O email ${email} não pertence à instituição.`);
        }
      } catch (error) {
        console.error("Erro no login:", error);
      }
    });

    btnLogout.addEventListener('click', () => signOut(auth));

    // Monitorizar o estado da sessão em tempo real
    onAuthStateChanged(auth, (user) => {
      if (user && user.email.endsWith(DOMINIO_PERMITIDO)) {
        // Mostrar App
        loginView.classList.add('hidden');
        appView.classList.remove('hidden');
        btnLogout.classList.remove('hidden');
        userBadge.classList.remove('hidden');
        userBadge.textContent = user.email;
      } else {
        // Mostrar Login
        loginView.classList.remove('hidden');
        appView.classList.add('hidden');
        btnLogout.classList.add('hidden');
        userBadge.classList.add('hidden');
      }
    });
  </script>
</body>
</html>
